{
  "name": "openai-proxy",
  "version": "0.28.0",
  "description": "Proxy for the OpenAI API",
  "private": true,
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "NODE_EXTRA_CA_CERTS=certs/ca-certificates.crt node --watch src/index.ts",
    "test": "node --test --experimental-strip-types --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:ci": "mkdir -p test-results && node --test --experimental-strip-types --test-concurrency=1 --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results/junit.xml \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "author": "Christian Gawron",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-http-proxy": "^2.0.0",
    "express-rate-limit": "^7.5.0",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "mongodb": "^6.5.0",
    "openid-client": "^5.6.5",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
